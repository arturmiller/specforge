@prefix sf: <https://specforge.dev/vocab/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix requirement: <https://specforge.dev/requirement/> .
@prefix verification: <https://specforge.dev/verification/> .
@prefix assertion: <https://specforge.dev/assertion/> .
@prefix source: <https://specforge.dev/source/> .

# SEC-001 beschreibt die überprüfbare Erwartung: Resources containing PersonalData require authenticated access.
requirement:SEC-001-1.0.0 a sf:RequirementDefinition ;
  # Diese Aussage legt die stabile Kennung der Ressource fest.
  dcterms:identifier "SEC-001" ;
  # Diese Aussage pinnt die konkrete Version der Ressource.
  dcterms:hasVersion "1.0.0" ;
  # Diese Aussage beschreibt die fachliche Bedeutung der Ressource.
  dcterms:description "Resources containing PersonalData require authenticated access." ;
    # Diese Aussage benennt die maschinenentscheidbare Systemeigenschaft per IRI.
    sf:control <https://specforge.dev/control/authentication> ;
    # Diese Aussage legt den Vergleichsoperator der Erwartung per IRI fest.
    sf:operator <https://specforge.dev/operator/equals> ;
  # Diese Aussage legt den einzelnen erwarteten Wert fest.
  sf:expectedValue "required" ;
    # Diese Aussage verbindet das Requirement mit einer ausführbaren Verification.
    sf:verifiedBy verification:TEST-SEC-001 ;
    # Diese Aussage verweist auf die konkrete Herkunft der Ressource.
    prov:wasDerivedFrom source:security-policy-authenticated-personal-data .

# Diese Verification führt TEST-SEC-001 mit dem Adapter http_request aus.
verification:TEST-SEC-001 a sf:Verification ;
  # Diese Aussage legt die stabile Kennung der Ressource fest.
  dcterms:identifier "TEST-SEC-001" ;
  # Diese Aussage benennt den ausführbaren Prüfadapter per IRI.
  sf:verificationAdapter <https://specforge.dev/verification-adapter/http_request> ;
  # Diese Aussage beschreibt die notwendige Vorbereitung der Verification.
  sf:setup "anonymous_all_crud" ;
  # Diese Aussage legt fest, ob die Verification verpflichtend ist.
  sf:mandatory "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
  # Diese Aussage verbindet die Verification mit ihrer prüfbaren Assertion.
  sf:assertion assertion:TEST-SEC-001 .

# Diese Assertion beschreibt die maschinenlesbaren Erwartungen von TEST-SEC-001.
assertion:TEST-SEC-001 a sf:AssertionSpec ;
  # Diese weitere Typangabe klassifiziert dieselbe Ressource zusätzlich.
  sf:responseStatus "401"^^<http://www.w3.org/2001/XMLSchema#integer> .

# Diese Quelle bezeichnet den normativen Abschnitt authenticated-personal-data in security-policy.
source:security-policy-authenticated-personal-data a prov:Entity ;
  # Diese Aussage klassifiziert die Art der Herkunftsquelle.
  sf:sourceType "internal_policy" ;
  # Diese Aussage legt die stabile Kennung der Ressource fest.
  dcterms:identifier "security-policy" ;
  # Diese Aussage pinnt die konkrete Version der Ressource.
  dcterms:hasVersion "1.0.0" ;
  # Diese Aussage benennt den relevanten Abschnitt der Herkunftsquelle.
  sf:sourceSection "authenticated-personal-data" .

# SEC-002 beschreibt die überprüfbare Erwartung: Users may access only resources they own.
requirement:SEC-002-1.0.0 a sf:RequirementDefinition ;
  # Diese Aussage legt die stabile Kennung der Ressource fest.
  dcterms:identifier "SEC-002" ;
  # Diese Aussage pinnt die konkrete Version der Ressource.
  dcterms:hasVersion "1.0.0" ;
  # Diese Aussage beschreibt die fachliche Bedeutung der Ressource.
  dcterms:description "Users may access only resources they own." ;
    # Diese Aussage benennt die maschinenentscheidbare Systemeigenschaft per IRI.
    sf:control <https://specforge.dev/control/authorization> ;
    # Diese Aussage legt den Vergleichsoperator der Erwartung per IRI fest.
    sf:operator <https://specforge.dev/operator/equals> ;
  # Diese Aussage legt den einzelnen erwarteten Wert fest.
  sf:expectedValue "ownership" ;
    # Diese Aussage verbindet das Requirement mit einer ausführbaren Verification.
    sf:verifiedBy verification:TEST-SEC-002 ;
    # Diese Aussage verweist auf die konkrete Herkunft der Ressource.
    prov:wasDerivedFrom source:security-policy-ownership .

# Diese Verification führt TEST-SEC-002 mit dem Adapter http_request aus.
verification:TEST-SEC-002 a sf:Verification ;
  # Diese Aussage legt die stabile Kennung der Ressource fest.
  dcterms:identifier "TEST-SEC-002" ;
  # Diese Aussage benennt den ausführbaren Prüfadapter per IRI.
  sf:verificationAdapter <https://specforge.dev/verification-adapter/http_request> ;
  # Diese Aussage beschreibt die notwendige Vorbereitung der Verification.
  sf:setup "foreign_user_all_crud" ;
  # Diese Aussage legt fest, ob die Verification verpflichtend ist.
  sf:mandatory "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
  # Diese Aussage verbindet die Verification mit ihrer prüfbaren Assertion.
  sf:assertion assertion:TEST-SEC-002 .

# Diese Assertion beschreibt die maschinenlesbaren Erwartungen von TEST-SEC-002.
assertion:TEST-SEC-002 a sf:AssertionSpec ;
  # Diese weitere Typangabe klassifiziert dieselbe Ressource zusätzlich.
  sf:responseStatus "404"^^<http://www.w3.org/2001/XMLSchema#integer> .

# Diese Quelle bezeichnet den normativen Abschnitt ownership in security-policy.
source:security-policy-ownership a prov:Entity ;
  # Diese Aussage klassifiziert die Art der Herkunftsquelle.
  sf:sourceType "internal_policy" ;
  # Diese Aussage legt die stabile Kennung der Ressource fest.
  dcterms:identifier "security-policy" ;
  # Diese Aussage pinnt die konkrete Version der Ressource.
  dcterms:hasVersion "1.0.0" ;
  # Diese Aussage benennt den relevanten Abschnitt der Herkunftsquelle.
  sf:sourceSection "ownership" .
