# PRODUCT-001 beschreibt die überprüfbare Erwartung: A user can create an event.
requirement:PRODUCT-001-1.0.0 a sf:RequirementDefinition ;
  # Diese Aussage legt die stabile Kennung der Ressource fest.
  dcterms:identifier "PRODUCT-001" ;
  # Diese Aussage pinnt die konkrete Version der Ressource.
  dcterms:hasVersion "1.0.0" ;
  # Diese Aussage beschreibt die fachliche Bedeutung der Ressource.
  dcterms:description "A user can create an event." ;
    # Diese Aussage benennt die maschinenentscheidbare Systemeigenschaft per IRI.
    sf:control <https://specforge.dev/control/event_create> ;
    # Diese Aussage legt den Vergleichsoperator der Erwartung per IRI fest.
    sf:operator <https://specforge.dev/operator/equals> ;
  # Diese Aussage legt den einzelnen erwarteten Wert fest.
  sf:expectedValue "enabled" ;
    # Diese Aussage verbindet das Requirement mit einer ausführbaren Verification.
    sf:verifiedBy verification:TEST-PRODUCT-001 ;
    # Diese Aussage verweist auf die konkrete Herkunft der Ressource.
    prov:wasDerivedFrom source:calendar-product-create .

# Diese Verification führt TEST-PRODUCT-001 mit dem Adapter http_request aus.
verification:TEST-PRODUCT-001 a sf:Verification ;
  # Diese Aussage legt die stabile Kennung der Ressource fest.
  dcterms:identifier "TEST-PRODUCT-001" ;
  # Diese Aussage benennt den ausführbaren Prüfadapter per IRI.
  sf:verificationAdapter <https://specforge.dev/verification-adapter/http_request> ;
  # Diese Aussage beschreibt die notwendige Vorbereitung der Verification.
  sf:setup "owner_create" ;
  # Diese Aussage legt fest, ob die Verification verpflichtend ist.
  sf:mandatory "true"^^<http://www.w3.org/2001/XMLSchema#boolean> ;
  # Diese Aussage verbindet die Verification mit ihrer prüfbaren Assertion.
  sf:assertion assertion:TEST-PRODUCT-001 .

# Diese Assertion beschreibt die maschinenlesbaren Erwartungen von TEST-PRODUCT-001.
assertion:TEST-PRODUCT-001 a sf:AssertionSpec ;
  # Diese weitere Typangabe klassifiziert dieselbe Ressource zusätzlich.
  sf:responseStatus "201"^^<http://www.w3.org/2001/XMLSchema#integer> ;
  # Diese weitere Typangabe klassifiziert dieselbe Ressource zusätzlich.
  sf:storedMatches "true"^^<http://www.w3.org/2001/XMLSchema#boolean> .

