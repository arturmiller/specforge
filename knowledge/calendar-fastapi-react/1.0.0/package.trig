@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix sf: <https://specforge.dev/vocab/> .
@prefix package: <https://specforge.dev/package/calendar-fastapi-react/> .

# Dieser Named Graph beschreibt die Integration zwischen Calendar-Domäne und FastAPI-React-Stack.
package:graph-metadata {
  # Das Integration Package bindet ausdrücklich eine Domain- und eine Implementation-Seite.
  package:1.0.0 a dcat:Dataset, sf:IntegrationPackage ;
    # Diese Aussage legt die stabile Kennung der Ressource fest.
    dcterms:identifier "calendar-fastapi-react" ;
    # Diese Aussage pinnt die konkrete Version der Ressource.
    dcterms:hasVersion "1.0.0" ;
    # Diese Aussage gibt der Ressource einen verständlichen Titel.
    dcterms:title "Calendar FastAPI React Integration"@en ;
    # Diese Aussage benennt das verantwortliche Team oder den Herausgeber.
    dcterms:publisher "calendar-team" ;
    # Diese Aussage beschreibt die fachliche Bedeutung der Ressource.
    dcterms:description "Connects Calendar domain requirements to FastAPI and React patterns."@en ;
    # Diese Aussage beschreibt Zweck und Bedeutung der Ressource.
    sf:bindsDomain <https://specforge.dev/package/calendar/1.1.0> ;
    # Diese Aussage beschreibt Zweck und Bedeutung der Ressource.
    sf:bindsImplementation <https://specforge.dev/package/fastapi-react/1.0.0> .

  # Diese Aussage katalogisiert patterns.ttl als Distribution dieser Package-Version.
  <https://specforge.dev/package/calendar-fastapi-react/1.0.0> dcat:distribution <https://specforge.dev/package/calendar-fastapi-react/1.0.0/distribution/patterns.ttl> .

  # Diese Ressource beschreibt die lokal ausgelieferte Datei patterns.ttl.
  <https://specforge.dev/package/calendar-fastapi-react/1.0.0/distribution/patterns.ttl> a dcat:Distribution ;
    # Diese Aussage legt den stabilen Dateinamen der Distribution fest.
    dcterms:identifier "patterns.ttl" ;
    # Diese Aussage nennt den standardisierten Medientyp der Distribution.
    dcat:mediaType "text/turtle" .
}
