@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix sf: <https://specforge.dev/vocab/> .
@prefix package: <https://specforge.dev/package/privacy/> .

# Dieser Named Graph beschreibt das app-unabhängige Privacy-Policy-Paket.
package:graph-metadata {
  # Privacy 1.1.0 liefert Begriffe, Rules und Requirements, ohne Calendar oder FastAPI zu kennen.
  package:1.1.0 a dcat:Dataset, sf:PolicyPackage ;
    # Diese Aussage legt die stabile Kennung der Ressource fest.
    dcterms:identifier "privacy" ;
    # Diese Aussage pinnt die konkrete Version der Ressource.
    dcterms:hasVersion "1.1.0" ;
    # Diese Aussage gibt der Ressource einen verständlichen Titel.
    dcterms:title "Privacy Policy Knowledge"@en ;
    # Diese Aussage benennt das verantwortliche Team oder den Herausgeber.
    dcterms:publisher "privacy-team" ;
    # Diese Aussage beschreibt die fachliche Bedeutung der Ressource.
    dcterms:description "Defines app-independent privacy concepts, rules, and requirements."@en .

  # Diese Aussage katalogisiert requirements.ttl als Distribution dieser Package-Version.
  <https://specforge.dev/package/privacy/1.1.0> dcat:distribution <https://specforge.dev/package/privacy/1.1.0/distribution/requirements.ttl> .

  # Diese Ressource beschreibt die lokal ausgelieferte Datei requirements.ttl.
  <https://specforge.dev/package/privacy/1.1.0/distribution/requirements.ttl> a dcat:Distribution ;
    # Diese Aussage legt den stabilen Dateinamen der Distribution fest.
    dcterms:identifier "requirements.ttl" ;
    # Diese Aussage nennt den standardisierten Medientyp der Distribution.
    dcat:mediaType "text/turtle" .

  # Diese Aussage katalogisiert rules.rif.xml als Distribution dieser Package-Version.
  <https://specforge.dev/package/privacy/1.1.0> dcat:distribution <https://specforge.dev/package/privacy/1.1.0/distribution/rules.rif.xml> .

  # Diese Ressource beschreibt die lokal ausgelieferte Datei rules.rif.xml.
  <https://specforge.dev/package/privacy/1.1.0/distribution/rules.rif.xml> a dcat:Distribution ;
    # Diese Aussage legt den stabilen Dateinamen der Distribution fest.
    dcterms:identifier "rules.rif.xml" ;
    # Diese Aussage nennt den standardisierten Medientyp der Distribution.
    dcat:mediaType "application/rif+xml" .

  # Diese Aussage katalogisiert rules.ttl als Distribution dieser Package-Version.
  <https://specforge.dev/package/privacy/1.1.0> dcat:distribution <https://specforge.dev/package/privacy/1.1.0/distribution/rules.ttl> .

  # Diese Ressource beschreibt die lokal ausgelieferte Datei rules.ttl.
  <https://specforge.dev/package/privacy/1.1.0/distribution/rules.ttl> a dcat:Distribution ;
    # Diese Aussage legt den stabilen Dateinamen der Distribution fest.
    dcterms:identifier "rules.ttl" ;
    # Diese Aussage nennt den standardisierten Medientyp der Distribution.
    dcat:mediaType "text/turtle" .

  # Diese Aussage katalogisiert vocabulary.ttl als Distribution dieser Package-Version.
  <https://specforge.dev/package/privacy/1.1.0> dcat:distribution <https://specforge.dev/package/privacy/1.1.0/distribution/vocabulary.ttl> .

  # Diese Ressource beschreibt die lokal ausgelieferte Datei vocabulary.ttl.
  <https://specforge.dev/package/privacy/1.1.0/distribution/vocabulary.ttl> a dcat:Distribution ;
    # Diese Aussage legt den stabilen Dateinamen der Distribution fest.
    dcterms:identifier "vocabulary.ttl" ;
    # Diese Aussage nennt den standardisierten Medientyp der Distribution.
    dcat:mediaType "text/turtle" .
}
