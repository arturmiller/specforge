@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix sf: <https://specforge.dev/vocab/> .
@prefix package: <https://specforge.dev/package/fastapi-react/> .

# Dieser Named Graph beschreibt das wiederverwendbare FastAPI-React-Implementation-Paket.
package:graph-metadata {
  # FastAPI React 1.0.0 liefert technische Patterns, entscheidet aber nicht über fachliche Geltung.
  package:1.0.0 a dcat:Dataset, sf:ImplementationPackage ;
    # Diese Aussage legt die stabile Kennung der Ressource fest.
    dcterms:identifier "fastapi-react" ;
    # Diese Aussage pinnt die konkrete Version der Ressource.
    dcterms:hasVersion "1.0.0" ;
    # Diese Aussage gibt der Ressource einen verständlichen Titel.
    dcterms:title "FastAPI React Implementation Knowledge"@en ;
    # Diese Aussage benennt das verantwortliche Team oder den Herausgeber.
    dcterms:publisher "platform-team" ;
    # Diese Aussage beschreibt die fachliche Bedeutung der Ressource.
    dcterms:description "Provides reusable FastAPI and React implementation patterns."@en .

  # Diese Aussage katalogisiert patterns.ttl als Distribution dieser Package-Version.
  <https://specforge.dev/package/fastapi-react/1.0.0> dcat:distribution <https://specforge.dev/package/fastapi-react/1.0.0/distribution/patterns.ttl> .

  # Diese Ressource beschreibt die lokal ausgelieferte Datei patterns.ttl.
  <https://specforge.dev/package/fastapi-react/1.0.0/distribution/patterns.ttl> a dcat:Distribution ;
    # Diese Aussage legt den stabilen Dateinamen der Distribution fest.
    dcterms:identifier "patterns.ttl" ;
    # Diese Aussage nennt den standardisierten Medientyp der Distribution.
    dcat:mediaType "text/turtle" .
}
